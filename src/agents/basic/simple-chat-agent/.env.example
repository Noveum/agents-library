# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# API Keys (choose based on your provider)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom API base URL (for OpenAI-compatible APIs)
# OPENAI_API_BASE=https://api.openai.com/v1

# Agent Configuration
AGENT_NAME=ChatBot
MAX_RESPONSE_TOKENS=1000
AGENT_TEMPERATURE=0.7

# Memory Configuration
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=20
MEMORY_MAX_TOKENS=4000
MEMORY_PERSIST=false
# MEMORY_FILE_PATH=./conversations.json

# Noveum Tracing Configuration
NOVEUM_ENABLED=true
NOVEUM_API_KEY=your_noveum_api_key_here
NOVEUM_PROJECT=simple-chat-agent
NOVEUM_ENVIRONMENT=development
NOVEUM_SAMPLE_RATE=1.0

# Optional: Custom system prompt
# SYSTEM_PROMPT="You are a helpful assistant specialized in..."

