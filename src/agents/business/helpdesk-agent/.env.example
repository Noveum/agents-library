# Company Configuration
COMPANY_NAME=TechCorp
AGENT_NAME=Support Agent

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# API Keys (choose based on your provider)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom API base URL
# OPENAI_API_BASE=https://api.openai.com/v1

# Agent Configuration
MAX_RESPONSE_TOKENS=1500
AGENT_TEMPERATURE=0.3

# Memory Configuration (larger for support context)
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=50
MEMORY_MAX_TOKENS=8000
MEMORY_PERSIST=true
MEMORY_FILE_PATH=./support_conversations.json

# Support-Specific Configuration
DEFAULT_PRIORITY=medium
AUTO_CATEGORIZE=true
AUTO_SUGGEST_ARTICLES=true
INCLUDE_TICKET_ID=true
INCLUDE_ESCALATION_NOTICE=true
MAX_CONVERSATION_CONTEXT=10

# Escalation Keywords (comma-separated)
ESCALATION_KEYWORDS=manager,supervisor,escalate,complaint,legal,lawsuit,cancel,refund,angry,frustrated,unacceptable

# Knowledge Base Configuration
# KNOWLEDGE_BASE_PATH=./knowledge_base/
# KNOWLEDGE_BASE_TYPE=file  # file, database, vector

# Noveum Tracing Configuration
NOVEUM_ENABLED=true
NOVEUM_API_KEY=your_noveum_api_key_here
NOVEUM_PROJECT=customer-support-agent
NOVEUM_ENVIRONMENT=development
NOVEUM_SAMPLE_RATE=1.0

