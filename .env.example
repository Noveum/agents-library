# AI Agents Library - Environment Configuration

# =============================================================================
# LLM Provider Configuration (Required)
# =============================================================================
# At least one LLM provider API key is required

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# LLM Settings
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# =============================================================================
# Noveum Tracing Configuration (Optional)
# =============================================================================
NOVEUM_ENABLED=true
NOVEUM_API_KEY=your-noveum-api-key-here
NOVEUM_PROJECT=agents-library
NOVEUM_ENVIRONMENT=development
NOVEUM_SAMPLE_RATE=1.0

# =============================================================================
# Memory Configuration
# =============================================================================
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=20
MEMORY_MAX_TOKENS=4000
MEMORY_PERSIST=false
MEMORY_FILE_PATH=./data/memory.json

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_NAME=AI Assistant
SYSTEM_PROMPT=You are a helpful AI assistant.
MAX_RESPONSE_TOKENS=1000
AGENT_TEMPERATURE=0.7

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
LOG_LEVEL=info
ENVIRONMENT=development

# =============================================================================
# Company/Organization Settings
# =============================================================================
COMPANY_NAME=Your Company
SUPPORT_EMAIL=support@yourcompany.com
ESCALATION_KEYWORDS=manager,supervisor,escalate,complaint,legal,lawsuit

